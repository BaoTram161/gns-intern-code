
<% if line_item == @current_item %>
  <tr id="<%= dom_id line_item %>" class="line-item-highlight">
<% else %>
  <tr id="<%= dom_id line_item %>">
<% end %>
  <td class="w-6 text-right align-top">
    <%= line_item.quantity %>
  </td>
  <td class="w-4 text-center align-top">&times;</td>
  <td class="px-1 align-top break-words">
    <%= line_item.product.title %>
  </td>
  <td class="w-20 text-right font-bold align-top break-words">
    <%= number_to_currency(line_item.total_price) %>
  </td>
</tr>